{
  "name": "summit-kitchen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Summit Kitchen Services Limited (RC 9927529) \u2014 e-commerce storefront and admin",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node --env-file-if-exists=.env --experimental-strip-types prisma/seed.ts",
    "db:reset": "prisma migrate reset",
    "admin:create": "node --env-file-if-exists=.env --experimental-strip-types scripts/create-admin.ts",
    "test": "npm run test:unit",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test:db": "bash tests/db/run.sh",
    "test:e2e": "playwright test"
  },
  "prisma": {
    "seed": "node --experimental-strip-types prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.16.2",
    "next": "15.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.55.1",
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "eslint": "9.36.0",
    "eslint-config-next": "15.5.4",
    "postcss": "8.5.6",
    "prisma": "6.16.2",
    "tailwindcss": "4.1.13",
    "typescript": "5.9.2"
  }
}
