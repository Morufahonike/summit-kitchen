# Copy to .env and fill in. NEVER commit .env.

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/summit_kitchen?schema=public"

# Public base URL of the site (used for Paystack callback + password reset links)
APP_URL="http://localhost:3000"

# Shared secret for the reservation-cleanup endpoint (POST /api/cron/release-reservations
# with header "Authorization: Bearer <CRON_SECRET>"). Generate with `openssl rand -hex 32`.
CRON_SECRET=""

# ---- Paystack -------------------------------------------------------------
# TEST keys only (they start with sk_test_ / pk_test_). The app REFUSES to start
# payments with a live key unless PAYSTACK_ALLOW_LIVE="true" — which must only be
# set after the business owner explicitly approves live payments.
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_ALLOW_LIVE="false"

# Store currency (Paystack Nigeria supports NGN and USD)
STORE_CURRENCY="NGN"

# Minutes an unpaid order holds reserved stock before it is released
RESERVATION_MINUTES="30"

# ---- Email (not yet configured) -------------------------------------------
# No email provider is connected. Until one is, password-reset links are
# written to the server log in development only.
EMAIL_FROM=""

# ---- Initial admin (used once by `npm run admin:create`) ------------------
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
