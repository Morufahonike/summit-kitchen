# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection string
DATABASE_URL="postgresql://summit:CHANGE_ME@localhost:5432/summit_kitchen?schema=public"

# Public base URL of the site (used for payment callbacks)
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Payments
# PAYMENT_PROVIDER = "paystack" | "mock"
#   mock     -> local Paystack simulator for development only (refused in production)
#   paystack -> real Paystack API. Use TEST keys (sk_test_...) only.
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER="mock"
PAYSTACK_SECRET_KEY="sk_test_replace_me"
PAYSTACK_PUBLIC_KEY="pk_test_replace_me"

# Live keys are refused unless this is exactly "true". Leave false until the owner approves go-live.
ALLOW_LIVE_PAYMENTS="false"

# Set to "true" ONLY after Paystack has enabled USD for the business
# (requires international payments + a Zenith Bank USD domiciliary account).
# When false, customers who browse in USD are charged the NGN equivalent.
PAYSTACK_USD_ENABLED="false"

# ---------------------------------------------------------------------------
# Exchange rate (USD -> NGN)
# FX_PROVIDER_URL returns JSON { rates: { NGN: number } }; cached in the DB.
# FX_FALLBACK_USD_NGN is used only if no live or stored rate is available.
# ---------------------------------------------------------------------------
FX_PROVIDER_URL="https://open.er-api.com/v6/latest/USD"
FX_CACHE_HOURS="6"
FX_FALLBACK_USD_NGN="1500"

# Initial admin account created by the seed script (change the password after first login)
SEED_ADMIN_EMAIL="admin@summitkitchen.example"
SEED_ADMIN_PASSWORD="replace-with-a-long-unique-password"
